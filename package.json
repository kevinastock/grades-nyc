{
  "name": "nyc-grades",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build-data && node scripts/prepare-data.mjs && vite --host 127.0.0.1",
    "build": "npm run build-data && node scripts/prepare-data.mjs --prune && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "update-data": "bash update-data.sh",
    "convert-data": "node scripts/convert-data.mjs",
    "build-data": "node scripts/build-data.mjs",
    "perf:build": "node scripts/perf/build.mjs",
    "perf:serve": "node scripts/perf/server.mjs",
    "perf:run": "node scripts/perf/run.mjs",
    "perf:summary": "node scripts/perf/summarize.mjs"
  },
  "dependencies": {
    "@knadh/oat": "0.8.0",
    "fuse.js": "^7.1.0",
    "maplibre-gl": "^6.11.2",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@types/node": "^24.5.0",
    "@types/supercluster": "^7.1.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "playwright": "1.62.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "source-map-js": "1.2.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
